{
  "manifest_version": 3,
  "name": "과제 한눈에 — 중앙대 e-Class",
  "version": "0.1.0",
  "description": "중앙대 e-Class의 모든 과목 과제 마감일을 한 화면에 D-day 순으로 모아 보여줍니다.",
  "default_locale": "ko",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://eclass3.cau.ac.kr/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "과제 한눈에"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "src/icons/icon16.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/capture-main.js"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ]
}
