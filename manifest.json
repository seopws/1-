{
  "manifest_version": 3,
  "name": "과제 한눈에 — LearningX Deadline Board",
  "version": "0.1.0",
  "description": "여러 과목에 흩어진 LearningX 과제 마감일을 한 화면에 모아 D-day 순으로 보여줍니다.",
  "default_locale": "ko",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "offscreen"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "과제 한눈에"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "src/icons/icon16.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/capture-main.js"],
      "matches": ["*://*/*"]
    }
  ]
}
